# Copy to .env and fill in. Never commit .env.
IMD_API_KEY=
IMD_EMAIL=
IMD_PASSWORD=
IMD_TOKEN_URL=https://api.imd.gov.in/api/oauth/token.php
IMD_AWS_URL=https://api.imd.gov.in/api/v1/aws_data
# Optional poller knobs. Hourly at :20 by default; IMD's call budget is small.
SKYGUARD_IMD_POLL=1
SKYGUARD_IMD_POLL_SECONDS=3600
SKYGUARD_IMD_POLL_MINUTE=20
# Optional pager. POST JSON on DEGRADED/CRITICAL transitions and HIGH hardware alerts. Weather never pages.
SKYGUARD_WEBHOOK_URL=
# Dashboard → API (server-side polls). Local default is http://127.0.0.1:8000.
# On Render Account B set this to Account A's public URL.
# SKYGUARD_API=https://YOUR-API.onrender.com
# Browser CSV export links (same public API URL when split across hosts).
# SKYGUARD_PUBLIC_API=https://YOUR-API.onrender.com
# Optional SQLite path (Render disk: /var/lib/skyguard/skyguard.db).
# SKYGUARD_DB=data/skyguard.db
# Docker image sets these so catalog + v2 weights resolve under /app after pip install.
# SKYGUARD_ROOT=/app
# SKYGUARD_DATA=/app/data

